# Copy this file and rename the copy to local.properties
# Do not commit local.properties

# Android SDK location
# Windows example:
sdk.dir=C\:\\Users\\YOUR_USERNAME\\AppData\\Local\\Android\\Sdk

# ATAK Gradle plugin JAR location
# Change this to wherever you store atak-gradle-takdev.jar
takdev.plugin=C\:\\path\\to\\atak-gradle-takdev.jar

# Optional: debug signing config
# Usually Android Studio creates this automatically at:
# C:\Users\YOUR_USERNAME\.android\debug.keystore
takDebugKeyFile=C\:\\Users\\YOUR_USERNAME\\.android\\debug.keystore
takDebugKeyFilePassword=android
takDebugKeyAlias=androiddebugkey
takDebugKeyPassword=android

# Optional: temporary release config for local development only
takReleaseKeyFile=C\:\\Users\\YOUR_USERNAME\\.android\\debug.keystore
takReleaseKeyFilePassword=android
takReleaseKeyAlias=androiddebugkey
takReleaseKeyPassword=android

# Optional: Ditto SDK sync test credentials
# Get these from https://portal.ditto.live/ and keep them out of git.
DITTO_APP_ID=88ed3c0c-bf9b-4da2-bc94-6c3ac95751a3
DITTO_PLAYGROUND_TOKEN=801317b0-9885-42e9-af80-ea3b27a0e41b
DITTO_AUTH_URL=https://i83inp.cloud.dittolive.app
