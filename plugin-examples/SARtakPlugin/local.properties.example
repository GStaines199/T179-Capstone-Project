# Copy to local.properties and change YOUR_USERNAME / SDK location.
# Forward slashes avoid Java .properties backslash escaping on Windows.
# Never commit local.properties, signing keys or Ditto credentials.
sdk.dir=C:/Users/YOUR_USERNAME/AppData/Local/Android/Sdk

# Build default: the ATAK SDK JAR two directories above this project.
# Override only if using an SDK stored elsewhere:
# takdev.plugin=C:/path/to/atak-gradle-takdev.jar

# Default API target; do not substitute an installed app's patch version.
atak.version=5.6.0

# Optional overrides. By default the build uses ~/.android/debug.keystore
# with alias androiddebugkey and the standard debug password android.
# takDebugKeyFile=C:/Users/YOUR_USERNAME/.android/debug.keystore
# takDebugKeyFilePassword=android
# takDebugKeyAlias=androiddebugkey
# takDebugKeyPassword=android

# Use organisation-controlled signing details for approved release delivery.
# takReleaseKeyFile=C:/private/location/release.jks
# takReleaseKeyFilePassword=YOUR_STORE_PASSWORD
# takReleaseKeyAlias=YOUR_ALIAS
# takReleaseKeyPassword=YOUR_KEY_PASSWORD

# Configure Ditto profiles inside SARtak or import an operation's join code.
# Ditto credentials in local.properties/environment are not embedded in APKs.
