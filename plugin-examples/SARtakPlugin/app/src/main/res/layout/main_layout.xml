<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="3dp"
    android:layout_marginRight="3dp"
    android:background="@color/darker_gray"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/home_tab_button"
                style="@style/SARtakActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_home" />

            <Button
                android:id="@+id/grid_tab_button"
                style="@style/SARtakActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:text="@string/tab_grid" />

            <Button
                android:id="@+id/team_tab_button"
                style="@style/SARtakActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:text="@string/tab_team" />

            <Button
                android:id="@+id/track_tab_button"
                style="@style/SARtakActionButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_weight="1"
                android:text="@string/tab_track" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_tab_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sartak_panel"
                android:orientation="vertical">

                <TextView
                    style="@style/SARtakSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/current_operation" />

                <TextView
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/mission_name" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SARtakLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/atak_role_label" />

                    <TextView
                        android:id="@+id/current_role_value"
                        style="@style/SARtakStatusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/member_view" />
                </LinearLayout>

                <TextView
                    android:id="@+id/plugin_health_value"
                    style="@style/SARtakStatusValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/sartak_status_yellow"
                    android:padding="6dp"
                    android:text="@string/plugin_health_starting" />

                <TextView
                    android:id="@+id/identity_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/identity_pending" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sartak_panel"
                android:orientation="vertical">

                <TextView
                    style="@style/SARtakSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/current_grid_info" />

                <TextView
                    android:id="@+id/home_cell_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/grid_no_cell" />

                <TextView
                    android:id="@+id/home_assignment_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/grid_no_cell" />

                <TextView
                    style="@style/SARtakLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/search_line_heading" />

                <TextView
                    android:id="@+id/home_search_line_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sartak_status_yellow"
                    android:padding="6dp"
                    android:text="@string/search_line_not_started" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SARtakLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/gps_heading" />

                        <TextView
                            android:id="@+id/home_gps_value"
                            style="@style/SARtakValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/gps_waiting" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SARtakLabel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/spacing_heading" />

                        <TextView
                            style="@style/SARtakValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/spacing_distance" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/SARtakLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/line_heading" />

                <TextView
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sartak_status_yellow"
                    android:padding="6dp"
                    android:text="@string/line_distance" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sartak_panel"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SARtakSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/quick_actions" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        style="@style/SARtakActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_mark" />

                    <Button
                        style="@style/SARtakActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="@string/action_photo" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        style="@style/SARtakActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_alert" />

                    <Button
                        style="@style/SARtakActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="@string/action_message" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sartak_panel"
                android:orientation="vertical">

                <TextView
                    style="@style/SARtakSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/messages_heading" />

                <TextView
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/sartak_status_green"
                    android:padding="6dp"
                    android:text="@string/message_latest"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/home_alerts_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/sartak_status_yellow"
                    android:padding="6dp"
                    android:text="@string/no_team_alerts" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grid_tab_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sartak_panel"
                android:orientation="vertical">

                <TextView
                    style="@style/SARtakSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/area_heading" />

                <TextView
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/area_grid_status"
                    android:visibility="gone" />

                <TextView
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/area_tracks_status"
                    android:visibility="gone" />

                <TextView
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/area_cleared_status"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/toggle_search_area_button"
                    style="@style/SARtakActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/show_lanes" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sartak_panel"
                android:orientation="vertical">

                <TextView
                    style="@style/SARtakSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/current_search_cell" />

                <TextView
                    style="@style/SARtakLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/grid_selected_cell" />

                <TextView
                    android:id="@+id/current_cell_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/grid_no_cell" />

                <TextView
                    style="@style/SARtakLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/grid_assignment" />

                <TextView
                    android:id="@+id/assignment_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/grid_no_cell" />

                <TextView
                    android:id="@+id/grid_progress_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/sartak_status_green"
                    android:padding="6dp"
                    android:text="@string/grid_progress_empty" />

                <TextView
                    style="@style/SARtakLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/search_line_heading" />

                <TextView
                    android:id="@+id/search_line_status_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sartak_status_yellow"
                    android:padding="6dp"
                    android:text="@string/search_line_not_started" />

                <TextView
                    android:id="@+id/search_line_members_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/search_line_member_empty" />

                <LinearLayout
                    android:id="@+id/search_line_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/start_search_line_button"
                            style="@style/SARtakActionButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/search_line_start" />

                        <Button
                            android:id="@+id/pause_search_line_button"
                            style="@style/SARtakActionButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:layout_weight="1"
                            android:text="@string/search_line_pause" />
                    </LinearLayout>

                    <TextView
                        style="@style/SARtakLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/search_line_colour" />

                    <Button
                        android:id="@+id/search_line_colour_button"
                        style="@style/SARtakActionButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/search_line_colour" />

                    <TextView
                        style="@style/SARtakLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/search_line_tolerance" />

                    <EditText
                        android:id="@+id/search_line_tolerance_input"
                        style="@style/ATAKEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:singleLine="true"
                        android:textColor="@color/sartak_text_primary" />
                </LinearLayout>

                <TextView
                    style="@style/SARtakLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/team_size" />

                <TextView
                    android:id="@+id/team_size_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0" />

                <Button
                    android:id="@+id/select_current_cell_button"
                    style="@style/SARtakActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/grid_select_cell" />

                <LinearLayout
                    android:id="@+id/grid_status_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/mark_partial_button"
                            style="@style/SARtakActionButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/grid_mark_partial" />

                        <Button
                            android:id="@+id/mark_complete_button"
                            style="@style/SARtakActionButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="6dp"
                            android:layout_weight="1"
                            android:text="@string/grid_mark_complete" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/clear_cell_button"
                        style="@style/SARtakActionButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/grid_clear_status" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/team_tab_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sartak_panel"
                android:orientation="vertical">

                <TextView
                    style="@style/SARtakSectionTitle"
                    android:id="@+id/team_name_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/team_name" />

                <TextView
                    style="@style/SARtakLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/team_roster" />

                <LinearLayout
                    android:id="@+id/team_member_cards_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    style="@style/SARtakLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/team_alerts" />

                <TextView
                    android:id="@+id/team_alerts_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/sartak_status_yellow"
                    android:padding="6dp"
                    android:text="@string/no_team_alerts" />

                <TextView
                    style="@style/SARtakLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/invites_requests" />

                <LinearLayout
                    android:id="@+id/invites_requests_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/team_marker_visibility_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sartak_panel"
                android:orientation="vertical">

                <TextView
                    style="@style/SARtakSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/team_marker_visibility" />

                <TextView
                    android:id="@+id/team_marker_visibility_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/team_marker_mode_team" />

                <Button
                    android:id="@+id/toggle_callsigns_button"
                    style="@style/SARtakActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/hide_callsigns" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/marker_mode_me_button"
                        style="@style/SARtakActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/team_marker_mode_me" />

                    <Button
                        android:id="@+id/marker_mode_team_button"
                        style="@style/SARtakActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="@string/team_marker_mode_team" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/marker_mode_leaders_button"
                        style="@style/SARtakActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/team_marker_mode_leaders" />

                    <Button
                        android:id="@+id/marker_mode_all_button"
                        style="@style/SARtakActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="@string/team_marker_mode_all" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/leader_team_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sartak_panel"
                android:orientation="vertical">

                <TextView
                    style="@style/SARtakSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/leader_team_actions" />

                <TextView
                    android:id="@+id/atak_contact_status_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/sartak_status_yellow"
                    android:padding="6dp"
                    android:text="@string/atak_contacts_waiting" />

                <EditText
                    android:id="@+id/team_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:hint="@string/team_name_hint"
                    android:singleLine="true"
                    android:textColor="@color/sartak_text_primary"
                    android:textColorHint="@color/sartak_text_secondary"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/team_id_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/team_id_hint"
                    android:singleLine="true"
                    android:textColor="@color/sartak_text_primary"
                    android:textColorHint="@color/sartak_text_secondary"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/save_team_setup_button"
                    style="@style/SARtakActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/save_team_setup" />

                <Button
                    android:id="@+id/remove_team_button"
                    style="@style/SARtakActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/remove_team"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/member_uid_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/member_uid_hint"
                    android:singleLine="true"
                    android:textColor="@color/sartak_text_primary"
                    android:textColorHint="@color/sartak_text_secondary"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/member_callsign_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/member_callsign_hint"
                    android:singleLine="true"
                    android:textColor="@color/sartak_text_primary"
                    android:textColorHint="@color/sartak_text_secondary"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/team_size_minus_button"
                        style="@style/SARtakActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/remove_member"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/team_size_plus_button"
                        style="@style/SARtakActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="@string/add_member" />
                </LinearLayout>

                <Button
                    android:id="@+id/refresh_atak_contacts_button"
                    style="@style/SARtakActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/refresh_atak_contacts" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/other_teams_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sartak_panel"
                android:orientation="vertical">

                <TextView
                    style="@style/SARtakSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/other_teams" />

                <TextView
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/sartak_status_yellow"
                    android:padding="6dp"
                    android:text="@string/other_team_dropdown" />

                <TextView
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/other_team_summary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/track_tab_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/sartak_panel"
                android:orientation="vertical">

                <TextView
                    style="@style/SARtakSectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/track_heading" />

                <TextView
                    android:id="@+id/track_status_value"
                    style="@style/SARtakStatusValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/track_status" />

                <TextView
                    android:id="@+id/track_details_value"
                    style="@style/SARtakValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/track_details" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/track_record_button"
                        style="@style/SARtakActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/track_pause" />

                    <Button
                        android:id="@+id/track_visibility_button"
                        style="@style/SARtakActionButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="6dp"
                        android:layout_weight="1"
                        android:text="@string/track_hide" />
                </LinearLayout>

                <Button
                    android:id="@+id/track_clear_button"
                    style="@style/SARtakActionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/track_clear" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
